# Red (ver wayfinder/tickets/007-decision-gas-signing-model.md)
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_CHAIN_ID=421614

# Wallet de servicio (relayer) — paga el gas de todo, nunca la expongas al cliente
RELAYER_PRIVATE_KEY=

# Se completa cuando el contrato Stylus esté desplegado
NEXT_PUBLIC_CONSTANCIA_CONTRACT_ADDRESS=

# Base de datos del backend (nombres/cuenta en claro para armar la constancia legible —
# on-chain solo vive el hash, ver wayfinder/tickets/006-modelo-datos-privacidad.md)
DATABASE_URL=

# Envío de correo (recuperar enlace perdido, ver wayfinder/tickets/014-recuperar-enlace-por-correo.md).
# Gmail SMTP porque no hay dominio propio para Resend. GMAIL_APP_PASSWORD es una contraseña de
# aplicación (no la contraseña normal de la cuenta) — se genera en la configuración de seguridad
# de la cuenta de Google.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Login opcional con Google para /perfil (ver wayfinder/tickets/012-cuentas-vs-gmail-oauth.md,
# reabierta). No reemplaza el acceso por enlace de receptora/pagador.
AUTH_SECRET= # generar con `npx auth secret`
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
